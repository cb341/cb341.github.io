#!/usr/bin/env bash
set -euo pipefail

# Usage: bin/render-pdfs SOURCE OUTPUT

SOURCE="${1:-}"
OUTPUT="${2:-}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -z "$SOURCE" || -z "$OUTPUT" || $# -ne 2 ]]; then
  echo "Usage: bin/render-pdfs SOURCE OUTPUT" >&2
  exit 1
fi

if [[ ! -f "$SOURCE" ]]; then
  echo "Markdown source not found: $SOURCE" >&2
  exit 1
fi

if ! command -v pandoc >/dev/null 2>&1; then
  echo "pandoc not found. Install pandoc 3.1 or newer." >&2
  exit 1
fi

if ! command -v typst >/dev/null 2>&1; then
  echo "typst not found. Install Typst, then retry." >&2
  exit 1
fi

PANDOC_VERSION="$(pandoc --version | head -n 1 | awk '{print $2}')"
PANDOC_MAJOR="${PANDOC_VERSION%%.*}"
PANDOC_REMAINDER="${PANDOC_VERSION#*.}"
PANDOC_MINOR="${PANDOC_REMAINDER%%.*}"
if ((PANDOC_MAJOR < 3 || (PANDOC_MAJOR == 3 && PANDOC_MINOR < 1))); then
  echo "pandoc 3.1 or newer is required; found $PANDOC_VERSION." >&2
  exit 1
fi

SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$(basename "$SOURCE")"
mkdir -p "$(dirname "$OUTPUT")"
OUTPUT="$(cd "$(dirname "$OUTPUT")" && pwd)/$(basename "$OUTPUT")"

cd "$ROOT"
exec pandoc "$SOURCE" \
  --from=markdown \
  --output="$OUTPUT" \
  --pdf-engine=typst \
  --template=_pdf/article.typ \
  --lua-filter=_pdf/captions.lua \
  --resource-path="$ROOT" \
  --syntax-highlighting=none \
  --metadata="article-url:${PDF_ARTICLE_URL:-}" \
  --metadata="date:${PDF_ARTICLE_DATE:-}"
